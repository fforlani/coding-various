import itertools

class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        chars = {c : -1 for c in s}
        max_length = 0
        cur_length = 0
        for i in range(len(s)):
            c = s[i]
            max_length = max(max_length, cur_length)
            if chars[c] > i - cur_length - 1:
                cur_length = i - chars[c]
            else:
                cur_length += 1
            chars[c] = i
        return max(max_length, cur_length)

